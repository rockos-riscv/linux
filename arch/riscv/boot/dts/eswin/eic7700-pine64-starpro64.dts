/dts-v1/;

#define CMA_SIZE        0x20000000

#include "eic7700.dtsi"

/ {
	compatible = "pine64,starpro64", "eswin,eic7700";
	model = "Pine64 StarPro64";

	aliases {
		mmc0 = &sdhci_emmc;
		mmc1 = &sdio0;
		serial0 = &uart0;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 CMA_SIZE>;
			alignment = <0x0 0x1000>;
			linux,cma-default;
		};
	};

	vcc_1v8: vcc1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

&cpu_opp_table {
	opp-1600000000 {
		opp-hz = /bits/ 64 <1600000000>;
		opp-microvolt = <900000>;
		clock-latency-ns = <70000>;
	};
};

&xtal24m {
	clock-frequency = <24000000>;
	clock-output-names = "xtal24m";
};

&pinctrl {
	status = "okay";
	vrgmii-supply = <&vcc_1v8>;

	pinctrl_gpio13: gpio13-grp {
		gpio13-pins {
			pins = "mode_set0";
			function = "gpio";
			input-enable;
			bias-pull-up;
		};
	};

	pinctrl_gpio16: gpio16-grp {
		gpio16-pins {
			pins = "mode_set3";
			function = "gpio";
			input-disable;
			bias-disable;
		};
	};

	pinctrl_gpio94: gpio94-grp {
		gpio94-pins {
			pins = "s_mode";
			function = "gpio";
			input-disable;
			bias-disable;
		};
	};

	pinctrl_pwm0: pwm0-grp {
		pwm0-pins {
			pins = "fan_pwm";
			function = "pwm";
		};
	};

	pinctrl_fan_tach_pins: fan-tach-grp {
		fan-tach-pins {
			pins = "fan_tach";
			function = "fan_tach";
		};
	};
};

&fan_control {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fan_tach_pins>;
};

&gmac0 {
	phy-handle = <&gmac0_phy0>;
	phy-mode = "rgmii-id";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio94>;
	status = "okay";
};

&gmac0_mdio {
	gmac0_phy0: ethernet-phy@0 {
		reg = <0>;
		reset-gpios = <&gpioC 30 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <80000>;
	};
};

&gmac1 {
	phy-handle = <&gmac1_phy0>;
	phy-mode = "rgmii-rxid";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio16>;
	rx-internal-delay-ps = <700>;
	tx-internal-delay-ps = <400>;
	status = "okay";
};

&gmac1_mdio {
	gmac1_phy0: ethernet-phy@0 {
		reg = <0>;
		reset-gpios = <&gpioA 16 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <80000>;
	};
};

&pcie {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm0>;
};

&sata {
	status = "okay";
};

&sata_phy {
	status = "okay";
};

&sdhci_emmc {
	status = "okay";
	/*
	 * The eMMC data strobe pin is wired to RST on this board, so HS400
	 * (which requires a working data strobe) cannot work. Cap the eMMC
	 * at HS200 1.8V.
	 */
	/delete-property/ mmc-hs400-1_8v;
	mmc-hs200-1_8v;
};

&sdio0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio13>;
	cd-gpios = <&gpioA 13 GPIO_ACTIVE_LOW>;
	disable-wp;
};

&uart0 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&usb0 {
	status = "okay";
};

&usb1 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&wdt1 {
	status = "okay";
};

&wdt2 {
	status = "okay";
};

&wdt3 {
	status = "okay";
};
